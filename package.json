{
  "name": "dsh-tool-subagent-batch",
  "version": "0.3.0",
  "description": "Rolling-window batch orchestration for DeepSeek Harness subagents with synchronous and asynchronous modes, user-owned concurrency, and per-task acceptance reports.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./recommend": "./bin/recommend.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-subagent-batch-recommend": "./bin/recommend.mjs"
  },
  "files": [
    "index.js",
    "bin",
    "cordis.patch.yml",
    "examples",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "test:unit": "node test/concurrency.test.js && node test/batch.test.js",
    "recommend": "node bin/recommend.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "subagent",
    "orchestration",
    "batch",
    "concurrency",
    "rolling-window",
    "async",
    "sync"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YixiangTang/dsh-tool-subagent-batch.git"
  },
  "homepage": "https://github.com/YixiangTang/dsh-tool-subagent-batch#readme",
  "bugs": {
    "url": "https://github.com/YixiangTang/dsh-tool-subagent-batch/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
